+export const RIGHT_SIDEBAR_MAX = 560
+/** Docked workspace-tool width before user resize. */
 export const RIGHT_SIDEBAR_DEFAULT = 320
 /** Details drag clamp floor. */
 export const DETAILS_MIN = 300
