Date: Thu, 27 Aug 2026 23:14:27 +0800
Subject: [PATCH] feat(ui-layout): resize docked workspace sidebar

---
 .../ui-layout/src/client/AppFrame.module.css  |  6 +++++
 .../client/ui-layout/src/client/AppFrame.tsx  | 26 ++++++++++++++++++-
 .../client/ui-layout/src/client/columns.ts    |  4 +--
 .../client/ui-layout/src/client/service.ts    |  7 +++++
 .../client/ui-layout/src/client/stores.ts     |  4 ++-
 .../ui-layout/tests/app-frame.client.spec.tsx | 21 +++++++++++++++
 .../ui-layout/tests/apply.client.spec.ts      |  2 +-
 .../tests/layout-store.client.spec.ts         | 11 +++++---
 .../ui-layout/tests/service.client.spec.ts    |  4 +++
 9 files changed, 77 insertions(+), 8 deletions(-)

diff --git a/packages/client/ui-layout/src/client/AppFrame.module.css b/packages/client/ui-layout/src/client/AppFrame.module.css
index abfd432e4..de500f6bc 100644
--- a/packages/client/ui-layout/src/client/AppFrame.module.css
+++ b/packages/client/ui-layout/src/client/AppFrame.module.css
@@ -81,6 +81,7 @@
   }
 }
 
+.handle[data-side='right-sidebar']::after,
 .handle[data-side='details']::after {
   content: '';
   position: absolute;
@@ -101,12 +102,17 @@
     background var(--ds-transition-duration-slow) var(--ds-ease-in-out);
 }
 
+.rightSidebarCol:hover ~ .handle[data-side='right-sidebar']::after,
 .detailsCol:hover ~ .handle[data-side='details']::after,
+.handle[data-side='right-sidebar']:hover::after,
+.handle[data-side='right-sidebar'][data-dragging='true']::after,
 .handle[data-side='details']:hover::after,
 .handle[data-side='details'][data-dragging='true']::after {
   opacity: 1;
 }
 
+.handle[data-side='right-sidebar']:hover::after,
+.handle[data-side='right-sidebar'][data-dragging='true']::after,
 .handle[data-side='details']:hover::after,
 .handle[data-side='details'][data-dragging='true']::after {
   background: var(--dsw-alias-button-floating-hover);
diff --git a/packages/client/ui-layout/src/client/AppFrame.tsx b/packages/client/ui-layout/src/client/AppFrame.tsx
index ff801e2b7..8e9982354 100644
--- a/packages/client/ui-layout/src/client/AppFrame.tsx
+++ b/packages/client/ui-layout/src/client/AppFrame.tsx
@@ -42,7 +42,7 @@ function RightSidebarColumn(props: { children?: ReactNode }) {
  * One drag handle: pointer capture, rAF-throttled dx reports against the drag-start origin.
  * `side` keys the hover-reveal CSS to the owning column.
  */
-function DragHandle(props: { side: 'sidebar' | 'details'; left: number; onStart: () => void; onDrag: (dx: number) => void; onEnd: () => void }) {
+function DragHandle(props: { side: 'sidebar' | 'right-sidebar' | 'details'; left: number; onStart: () => void; onDrag: (dx: number) => void; onEnd: () => void }) {
   const [dragging, setDragging] = useState(false)
   const origin = useRef(0)
   const latest = useRef(0)
@@ -74,6 +74,19 @@ function DragHandle(props: { side: 'sidebar' | 'details'; left: number; onStart:
     setDragging(false)
     callbacks.current.onEnd()
   }, [])
+  const onKeyDown = useCallback((e: React.KeyboardEvent<HTMLDivElement>) => {
+    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return
+    e.preventDefault()
+    const amount = e.shiftKey ? 64 : 16
+    callbacks.current.onStart()
+    callbacks.current.onDrag(e.key === 'ArrowLeft' ? -amount : amount)
+    callbacks.current.onEnd()
+  }, [])
+  const labels = {
+    sidebar: 'Resize navigation sidebar',
+    'right-sidebar': 'Resize workspace sidebar',
+    details: 'Resize details sidebar',
+  } as const
 
   return (
     <div
@@ -81,9 +94,14 @@ function DragHandle(props: { side: 'sidebar' | 'details'; left: number; onStart:
       style={{ left: props.left }}
       data-side={props.side}
       data-dragging={dragging || undefined}
+      role="separator"
+      aria-orientation="vertical"
+      aria-label={labels[props.side]}
+      tabIndex={0}
       onPointerDown={onPointerDown}
       onPointerMove={onPointerMove}
       onPointerUp={onPointerUp}
+      onKeyDown={onKeyDown}
     />
   )
 }
@@ -157,12 +175,14 @@ export function AppFrame({
   // concession-clamped panel must not jump back to the stored preference);
   // it stays frozen for the whole gesture so dx deltas do not compound.
   const sidebarBase = useRef(0)
+  const rightSidebarBase = useRef(0)
   const detailsBase = useRef(0)
   // Track-level transitions pause for the whole gesture: eased tracks would
   // detach the column edge from the pointer (AppFrame.module.css).
   const [dragging, setDragging] = useState(false)
   const onDragEnd = useCallback(() => { setDragging(false) }, [])
   const onSidebarStart = useCallback(() => { sidebarBase.current = colsRef.current.sidebar; setDragging(true) }, [])
+  const onRightSidebarStart = useCallback(() => { rightSidebarBase.current = colsRef.current.rightSidebar; setDragging(true) }, [])
   const onDetailsStart = useCallback(() => { detailsBase.current = colsRef.current.details; setDragging(true) }, [])
   const onSidebarDrag = useCallback((dx: number) => {
     actions.setSidebar(sidebarBase.current + dx)
@@ -170,6 +190,9 @@ export function AppFrame({
   const onDetailsDrag = useCallback((dx: number) => {
     actions.setDetails(detailsBase.current - dx)
   }, [actions])
+  const onRightSidebarDrag = useCallback((dx: number) => {
+    actions.setRightSidebar(rightSidebarBase.current - dx)
+  }, [actions])
 
   return (
     <div
@@ -208,6 +231,7 @@ export function AppFrame({
       </div>
       {/* The collapsed rail is fixed-width: no resize handle while closed. */}
       {!sidebarCollapsed && <DragHandle side="sidebar" left={cols.sidebar} onStart={onSidebarStart} onDrag={onSidebarDrag} onEnd={onDragEnd} />}
+      {cols.rightSidebar > 0 && <DragHandle side="right-sidebar" left={viewport - cols.details - cols.rightSidebar} onStart={onRightSidebarStart} onDrag={onRightSidebarDrag} onEnd={onDragEnd} />}
       {cols.details > 0 && <DragHandle side="details" left={viewport - cols.details} onStart={onDetailsStart} onDrag={onDetailsDrag} onEnd={onDragEnd} />}
     </div>
   )
