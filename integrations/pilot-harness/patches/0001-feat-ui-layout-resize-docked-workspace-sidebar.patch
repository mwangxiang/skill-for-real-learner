+++ b/packages/client/ui-layout/src/client/stores.ts
@@ -10,7 +10,7 @@
 import { defineStore, type EngineStoreHandle } from '@deepseek-ai/dsh-client-runtime/client'
 import {
   clampWidth, DETAILS_DEFAULT, DETAILS_MAX, DETAILS_MIN,
-  RIGHT_SIDEBAR_DEFAULT,
+  RIGHT_SIDEBAR_DEFAULT, RIGHT_SIDEBAR_MAX, RIGHT_SIDEBAR_MIN,
   SIDEBAR_DEFAULT, SIDEBAR_MAX, SIDEBAR_MIN,
 } from './columns.ts'
 
@@ -35,6 +35,7 @@ type LayoutState = {
  */
 type LayoutActions = {
   setSidebar: (draft: LayoutState, px: number) => void
+  setRightSidebar: (draft: LayoutState, px: number) => void
   setDetails: (draft: LayoutState, px: number) => void
   toggleSidebar: (draft: LayoutState) => void
   setNarrow: (draft: LayoutState, narrow: boolean) => void
@@ -70,6 +71,7 @@ export function createLayoutStore(): EngineStoreHandle<LayoutState, LayoutAction
     }),
     actions: {
       setSidebar: (d, px: number) => { d.sidebar = clampWidth(px, SIDEBAR_MIN, SIDEBAR_MAX) },
+      setRightSidebar: (d, px: number) => { d.rightSidebar = clampWidth(px, RIGHT_SIDEBAR_MIN, RIGHT_SIDEBAR_MAX) },
       setDetails: (d, px: number) => { d.details = clampWidth(px, DETAILS_MIN, DETAILS_MAX) },
       // Narrow toggles flip only the override: the width preference survives
       // untouched, so re-widening restores the pre-squeeze layout.
diff --git a/packages/client/ui-layout/tests/app-frame.client.spec.tsx b/packages/client/ui-layout/tests/app-frame.client.spec.tsx
index 71cd8f7dd..048822501 100644
--- a/packages/client/ui-layout/tests/app-frame.client.spec.tsx
+++ b/packages/client/ui-layout/tests/app-frame.client.spec.tsx
@@ -266,6 +266,27 @@ describe('AppFrame', () => {
     expect(tracks(frame)[1]).toBe(420)
   })
 
+  it('right-sidebar drag widens leftward and exposes an accessible separator', () => {
+    const { frame, instance } = mountFrame()
+    act(() => { instance.actions.openRightSidebar() })
+    const handle = frame.querySelector('[data-side="right-sidebar"]')!
+    expect(handle.getAttribute('role')).toBe('separator')
+    expect(handle.getAttribute('aria-orientation')).toBe('vertical')
+    expect(handle.getAttribute('tabindex')).toBe('0')
+    drag(handle, 1600, 1520)
+    expect(instance.getSnapshot().rightSidebar).toBe(400)
+  })
+
+  it('right-sidebar keyboard resize uses 16px steps and Shift uses 64px', () => {
+    const { frame, instance } = mountFrame()
+    act(() => { instance.actions.openRightSidebar() })
+    const handle = frame.querySelector('[data-side="right-sidebar"]')!
+    act(() => { handle.dispatchEvent(new KeyboardEvent('keydown', { key: 'ArrowLeft', bubbles: true })) })
+    expect(instance.getSnapshot().rightSidebar).toBe(336)
+    act(() => { handle.dispatchEvent(new KeyboardEvent('keydown', { key: 'ArrowRight', shiftKey: true, bubbles: true })) })
+    expect(instance.getSnapshot().rightSidebar).toBe(272)
+  })
+
   it('drag base is the rendered (concession-clamped) width, not the preference', () => {
     frameWidth = 1250 // step-2 squeeze: details renders 330 while preference is 360
     const { frame, instance } = mountFrame()
