index b60e0e4fe..e93959c0c 100644
--- a/packages/client/ui-layout/src/client/service.ts
+++ b/packages/client/ui-layout/src/client/service.ts
@@ -31,6 +31,8 @@ export interface ILayout {
   openRightSidebar?(): void
   /** Close the additive docked workspace-tool column. */
   closeRightSidebar?(): void
+  /** Resize the additive docked workspace-tool column within its contract range. */
+  setRightSidebarWidth?(px: number): void
 }
 
 /** Cross-plugin panel-action face (ctx.layout). */
@@ -73,6 +75,11 @@ export class LayoutController implements ILayout {
     this.#require().closeRightSidebar()
   }
 
+  /** Resize the additive docked workspace-tool column. */
+  setRightSidebarWidth(px: number): void {
+    this.#require().setRightSidebar(px)
+  }
+
   #require(): PanelActions {
     // Callers are UI gestures, which cannot fire before the root entry
     // rendered (the inject hook runs in its first render) — reaching this
diff --git a/packages/client/ui-layout/src/client/stores.ts b/packages/client/ui-layout/src/client/stores.ts
index 5bfff9a0b..a9197b640 100644
